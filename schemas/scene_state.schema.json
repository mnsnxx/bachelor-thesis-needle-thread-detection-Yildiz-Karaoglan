{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneState",
  "type": "object",
  "required": ["frame_id", "timestamp_monotonic_ns", "calibration_version", "scene_quality", "objects"],
  "properties": {
    "frame_id": {"type": "integer", "minimum": 0},
    "timestamp_monotonic_ns": {"type": "integer", "minimum": 0},
    "calibration_version": {"type": "string", "minLength": 1},
    "scene_quality": {"enum": ["PASS", "DEGRADED", "FAIL"]},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "track_id", "confidence", "visible", "occluded"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["needle", "suture", "wound_edge", "tool_tip", "marker"]},
          "track_id": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "visible": {"type": "boolean"},
          "occluded": {"type": "boolean"}
        }
      }
    }
  }
}
